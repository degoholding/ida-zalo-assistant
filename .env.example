# Sao thành .env rồi điền. Không commit .env.

# MySQL — trong docker compose là mysql://bot:<mật khẩu>@mysql:3306/bot_tro_ly (compose tự đặt)
DATABASE_URL=mysql://bot:doi-mat-khau@127.0.0.1:3306/bot_tro_ly
MYSQL_PASSWORD=doi-mat-khau
MYSQL_ROOT_PASSWORD=doi-mat-khau-root

# Khóa mã hóa phiên Zalo — tạo bằng: docker compose run --rm --no-deps app node dist/cli.js gen-key. Mất khóa = mọi tài khoản bot phải quét QR lại.
SESSION_ENCRYPTION_KEY=

DATA_DIR=./data

# local = lưu tệp ở DATA_DIR/files · r2 = Cloudflare R2
STORAGE_DRIVER=local
# Điền R2_ENDPOINT đầy đủ, hoặc chỉ R2_ACCOUNT_ID
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=bot-tro-ly/

# Nhóm mới bot vừa vào: mặc định KHÔNG đọc (chạy thật). Lấy file mặc định BẬT từ 27/10/2026 (nhóm có đọc thì lưu đủ tệp);
# nhóm đã có giữ nguyên cờ. Cài đặt trên web (app_setting) thắng biến này.
DEFAULT_GROUP_READ=false
DEFAULT_GROUP_CAPTURE_FILES=true

MAX_FILE_MB=100
DOWNLOAD_CONCURRENCY=3
HEARTBEAT_SECONDS=60

# Giao diện quản trị (đăng nhập QR, cấu hình nhóm, tải tệp)
# Mặc định chỉ nghe trong máy; vào từ xa qua đường hầm SSH hoặc Cloudflare Access.
WEB_HOST=127.0.0.1
WEB_PORT=8090
# Không còn mật khẩu quản trị chung (08/10/2026): mỗi người đăng nhập bằng tên + mật khẩu riêng (màn Người dùng).
# Tài khoản quản trị đầu tiên / quên mật khẩu: docker compose exec app node dist/cli.js user-admin <tên> <mật khẩu>
# Bật khi chạy sau HTTPS
COOKIE_SECURE=false
# Chỉ bật khi đứng sau Cloudflare (đếm sai mật khẩu theo IP thật của người dùng)
TRUST_CLOUDFLARE_IP=false

# Tin nhắn riêng 1-1 với bot: người ta chủ động nhắn nên mặc định LƯU
DEFAULT_DM_READ=true
DEFAULT_DM_CAPTURE_FILES=true

# Trợ lý AI — bot trả lời tin riêng của người có vai trò (Quản lý / Trưởng phòng ở màn Danh bạ).
# Để trống GEMINI_API_KEY = tắt trợ lý: vẫn lưu tin, không trả lời ai.
GEMINI_API_KEY=
# Khóa OpenAI (sk-…) — dùng khi GEMINI_MODEL / GEMINI_MODEL_HEAVY đặt là «gpt-…», «o3…» (bot tự chọn theo tên mô hình)
OPENAI_API_KEY=
# Tìm web riêng cho trợ lý (app.tavily.com, «tvly-…») — trống = chỉ tìm qua Gemini
TAVILY_API_KEY=
# Nhà cung cấp AI: gemini | openai | openai_then_gemini (ưu tiên OpenAI, lỗi thì dùng Gemini)
AI_PROVIDER=gemini
OPENAI_MODEL=gpt-6-luna
OPENAI_MODEL_HEAVY=gpt-6.1-sol
OPENAI_FALLBACK_MODELS=gpt-6.1-sol
# Khóa mua qua bên bán lại / proxy: địa chỉ API họ đưa (mặc định https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_MODEL=gemini-3.5-flash-lite
# Lượt nặng (tóm tắt dài, đọc tệp / ảnh) đi bản này; bot tự chuyển khi dữ liệu kéo về nhiều
GEMINI_MODEL_HEAVY=gemini-3.5-flash
# Tệp lớn hơn thì bot từ chối đọc (xlsx, docx, pdf, txt, csv, ảnh)
ASSISTANT_MAX_READ_FILE_MB=5
# Mô hình chính quá tải (503) thì thử lại 1 lần, hết hạn mức (429) / không còn (404) thì rồi chuyển lần lượt sang các mô hình này (cách nhau dấu phẩy)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest
# Mỗi người tối đa bao nhiêu câu hỏi một giờ
ASSISTANT_MAX_PER_HOUR=30
# Trần token cả hệ thống mỗi ngày (giờ Việt Nam); chạm trần thì nghỉ tới hôm sau
ASSISTANT_DAILY_TOKEN_CAP=3000000
# Giãn cách giữa hai tin bot gửi (mili giây)
ASSISTANT_SEND_INTERVAL_MS=1500
# Số câu hỏi trả lời song song tối đa (mọi tài khoản bot cộng lại); câu dư xếp hàng chờ
ASSISTANT_CONCURRENCY=6
# Việc nền (dọn tin quá hạn, ảnh đại diện, hàng đợi) chạy ngay trong tiến trình chính (true, máy dev) hay ở
# service worker riêng (docker-compose.yml đặt false cho app và bật service worker)
WORKER_EMBEDDED=true
# Trần token mỗi ngày của MỘT tài khoản bot; 0 = chỉ theo trần cả hệ thống
ASSISTANT_DAILY_TOKEN_CAP_PER_BOT=0
# Giữ bản sao lưu CSDL hằng ngày trên kho tệp bấy nhiêu ngày
BACKUP_KEEP_DAYS=30
# Bot Telegram + chat nhận báo khi phiên Zalo văng (sửa được ở Cài đặt → Vận hành)
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Client ID nút «Đăng nhập bằng Google» (sửa được ở Cài đặt → Google); trống = chỉ đăng nhập bằng tên + mật khẩu
GOOGLE_LOGIN_CLIENT_ID=
# App Google (Kết nối Google) đang ở chế độ Testing: refresh token sống 7 ngày, menu web báo hạn + cảnh báo trước 1 ngày.
# Chuyển app sang In production thì đặt false: token không hết hạn theo ngày, menu chỉ báo đỏ khi Google từ chối.
GOOGLE_OAUTH_TESTING=true

# Số tin gần nhất xin Zalo khi bấm «Lấy tin cũ» / vừa bật đọc một nhóm

# ---- Cổng MCP /mcp (phase 3): cho Claude Code / Codex / client SDK đọc dữ liệu bằng khóa Bearer tạo ở màn «Khóa MCP» (hoặc CLI) ----
# Mặc định TẮT (404). Bật thì BẮT BUỘC đặt MCP_ALLOWED_HOSTS đúng tên miền công khai khi chạy sau Cloudflare Tunnel.
MCP_ENABLED=false
# Tên máy (không cổng) được phép trong tiêu đề Host / Origin, cách nhau dấu phẩy. Prod: botida.degoholding.vn
MCP_ALLOWED_HOSTS=127.0.0.1,localhost
# Số lời gọi công cụ tối đa mỗi phút của một khóa + số lời gọi chạy cùng lúc tối đa
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_MAX_CONCURRENT_PER_KEY=4
# Trần lời gọi chạy cùng lúc của CẢ hệ thống (pool MySQL 10 kết nối dùng chung với đồng bộ Zalo + web); dư thì xếp hàng
# tối đa MCP_QUEUE_WAIT_MS mili giây rồi trả «server_busy»
MCP_MAX_CONCURRENT=3
MCP_QUEUE_WAIT_MS=5000
# Một IP sai khóa quá ngần này lần mỗi phút thì bị chặn tạm (429). Sau Cloudflare cần TRUST_CLOUDFLARE_IP=true để thấy IP thật
MCP_BAD_KEY_LIMIT_PER_MINUTE=20
# Gốc công khai của bot — issuer OAuth cho claude.ai / ChatGPT / Connectors của Claude Desktop (27/10/2026). Trống thì OAuth chỉ
# chạy ở máy local (Host 127.0.0.1 / localhost), máy khác trả 503. Prod: https://botida.degoholding.vn
MCP_PUBLIC_URL=
# get_file trả TỆP GỐC (ảnh / PDF / link tải hạn 5 phút) cho AI ngoài — NGOẠI LỆ của «che dữ liệu cá nhân» (ảnh chụp có SĐT / STK đi
# nguyên), chỉ Quản trị / Quản lý dùng MCP. Đại ca chốt 27/10/2026: mặc định BẬT. Đặt false thì get_file chỉ trả chữ đã bóc (đã che).
MCP_FILE_RAW=true
