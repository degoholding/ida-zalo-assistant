{
  "name": "bot-tro-ly",
  "private": true,
  "version": "0.1.0",
  "description": "Bot trợ lý đọc nhóm Zalo — bản đồng bộ cơ bản",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev-server-with-web-watch.mjs",
    "dev:server": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "seed:demo": "tsx --env-file-if-exists=.env src/dev/seed-demo-data.ts",
    "ask": "tsx --env-file-if-exists=.env src/dev/ask-assistant-cli.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts src/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "mysql2": "^3.11.0",
    "pdfmake": "^0.3.11",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zca-js": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
