{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    // zca-js 2.2.0 đóng gói lỗi: index.d.ts ở gốc ghi `export * from "./dist"` — ESM không
    // nhận import thư mục, nên mọi kiểu biến mất. Trỏ thẳng vào tệp khai kiểu thật.
    "paths": { "zca-js": ["./node_modules/zca-js/dist/index.d.ts"] }
  },
  "include": ["src"]
}
